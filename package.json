{
  "name": "pigeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mail from people you've chosen. Everyone else waits at the door.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
