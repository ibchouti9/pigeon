{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Pigeon window is allowed to ask the Rust side for. The three notification permissions are the whole of Pigeon's use of them: ask whether it may notify, ask for permission, and post one. Nothing reads notifications back, schedules them, or manages channels.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://myaccount.google.com/*" },
        { "url": "https://console.anthropic.com/*" },
        { "url": "https://platform.openai.com/*" },
        { "url": "https://aistudio.google.com/*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
